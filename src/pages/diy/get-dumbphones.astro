---
/*
  DIY subpage 2 of 4 — How to Get Dumbphones (/diy/get-dumbphones).

  Sections, top to bottom (ticker, masthead, footer come from BaseLayout):
    1. Hero       — the M ❀ logo
    2. Heading    — cyan "* HOW TO GET DUMBPHONES" bar
    3. Body       — two blue sub-headings, a photo, and a black "submit your
                    cohort" CTA out to dumb.co
    4. Next       — link forward to the next subpage in the read-in-order set

  No "Resources" section on this page (the design doesn't have one). The blue
  sub-headings use the shared `.label` bar style (in global.css); the black
  button mirrors the DIY landing page's Lydia call-to-action.
---------------------------------------------------------------------------*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import NextLink from '../../components/NextLink.astro';
import { getEntry } from 'astro:content';

const { data: page } = await getEntry('diy-get-dumbphones', 'page');
---

<BaseLayout title={page.title} masthead={page.masthead}>
  <div class="sections">
    <!-- 1. Hero -->
    <Hero />

    <!-- 2. Heading -->
    <SectionHeader label={page.sectionLabel} color="cyan" />

    <!-- 3. Body -->
    <section class="card">
      <h3 class="label">{page.subheading1}</h3>
      <p class="body" set:html={page.paragraph1} />
      <p class="body" set:html={page.paragraph2} />

      <!-- BBC Archive clip: "1998: Can Computers and Phones Combine?" (starts at 1s). -->
      <div class="video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/EuF65Ohn51M?start=1"
          title="1998: Can COMPUTERS and PHONES Combine? — The Money Programme, BBC Archive"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>

      <h3 class="label">{page.subheading2}</h3>
      <p class="body" set:html={page.paragraph3} />
      <p class="body" set:html={page.paragraph4} />
      <ul class="options">
        {page.options.map((option) => (
          <li set:html={option} />
        ))}
      </ul>
      <p class="body" set:html={page.paragraph5} />
      <p class="body" set:html={page.paragraph6} />

      <img
        class="card__photo"
        src="/images/dumbphones.png"
        width="1500"
        height="1000"
        alt="Participants gathered around a table setting up their dumbphones"
      />

    </section>

    <!-- 4. Ring ring -->
    <SectionHeader label={page.ringRingSectionLabel} color="yellow" />
    <section class="lydia">
      <div class="lydia__top">
        <p class="body" set:html={page.ringRing.paragraph} />
        <img class="lydia__photo" src="/images/lydia.jpg" width="1200" height="1200" alt="Lydia, a Month Offline organizer" />
      </div>
      <a class="lydia__btn font-display" href="https://tally.so/r/RGgD2p">{page.ringRing.buttonLabel}</a>
    </section>

    <!-- 5. Next — read-in-order, per CLAUDE.md (Get Dumbphones → Facilitate Meetups → …). -->
    <NextLink label={page.nextLinkLabel} href="/diy/facilitate-meetups" />
  </div>
</BaseLayout>

<style>
  /* Standard body paragraph (Syne Mono). */
  .body {
    font-size: var(--size-body);
    line-height: var(--leading-body);
  }
  .body + .body {
    margin-top: var(--space-3);
  }

  /* The three acquisition options, bulleted -- same pattern as the "What
     should I bring?" list on the Facilitate Meetups page. */
  .options {
    list-style: disc;
    margin: var(--space-2) 0;
    padding-left: 1.5em;
    font-size: var(--size-body);
    line-height: var(--leading-body);
  }
  .options li + li {
    margin-top: var(--space-1);
  }

  /* Match the blue underlined link style used inside .body (global.css) --
     that rule doesn't reach into this list since it's scoped to .body. */
  .options a {
    color: var(--mo-blue);
    text-decoration: underline;
  }
  .options a:hover {
    background-color: var(--mo-blue);
    color: var(--white);
  }

  /* The photo sits between the two sub-sections inside the white card. */
  .card__photo {
    width: 100%;
    height: auto;
    margin: var(--space-3) 0;
  }

  /* Responsive 16:9 video embed — same vertical rhythm as the photo. The
     wrapper holds the aspect ratio; the iframe fills it. */
  .video {
    aspect-ratio: 16 / 9;
    margin: var(--space-3) 0;
  }
  .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

</style>
