---
/*
  DIY Guide — landing page (/diy).

  Sections, top to bottom (ticker, masthead, footer come from BaseLayout):
    1. Hero            — the M ❀ logo
    2. Guide links     — the four ordered subpages, then the Resource Library
    3. Letter          — "Dear future organizers" backstory
    4. The basics      — the 6-week program
    5. Ring ring       — join the next Q&A (info session signup)
    6. Next            — cyan bar forward to the first subpage

  The RSVP link is a placeholder (href="#") until the info-session signup URL
  is shared.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import GuideLink from '../../components/GuideLink.astro';
import ProgramStep from '../../components/ProgramStep.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import NextLink from '../../components/NextLink.astro';
import { getEntry } from 'astro:content';

const { data: diyIndex } = await getEntry('diy-index', 'index');

// The number/href/color for each guide link and program step is design —
// tied to fixed positions in the layout, not something you'd edit in the
// content file — so it stays here. Only the text (diyIndex.guideLinkLabels,
// diyIndex.program) comes from the copy doc.
const GUIDE_LINK_META = [
  { number: '01', href: '/diy/gather-participants', color: 'yellow' },
  { number: '02', href: '/diy/get-dumbphones',       color: 'yellow' },
  { number: '03', href: '/diy/facilitate-meetups',   color: 'yellow' },
  { number: '04', href: '/diy/host-an-exhibition',   color: 'yellow' },
  { number: '05', href: '/resources',                color: 'yellow' },
];
const guideLinks = GUIDE_LINK_META.map((meta, i) => ({ ...meta, label: diyIndex.guideLinkLabels[i] }));

const PROGRAM_META = [
  { number: 1, color: 'yellow' },
  { number: 2, color: 'cyan' },
  { number: 3, color: 'pink' },
  { number: 4, color: 'blue' },
  { number: 5, color: 'red' },
  { number: 6, color: 'black' },
];
const program = PROGRAM_META.map((meta, i) => ({ ...meta, ...diyIndex.program[i] }));
---

<BaseLayout title={diyIndex.title} masthead={diyIndex.masthead}>
  <div class="sections">
    <!-- 1. Hero -->
    <Hero />

    <!-- 2. Guide links -->
    {guideLinks.map((link) => (
      <GuideLink number={link.number} label={link.label} href={link.href} color={link.color} />
    ))}

    <!-- 3. Letter -->
    <section class="card">
      <h3 class="letter__salutation font-display">{diyIndex.letter.salutation}</h3>
      <p class="body" set:html={diyIndex.letter.paragraph1} />
      <p class="body" set:html={diyIndex.letter.paragraph2} />

      <div class="letter__audio">
        <AudioPlayer
          title={diyIndex.audio.title}
          byline={diyIndex.audio.byline}
          src="/audio/1844OFFLINE.mp3"
        />
      </div>

      <p class="body" set:html={diyIndex.letter.paragraph3} />
      <p class="body" set:html={diyIndex.letter.paragraph4} />
      <p class="body letter__signoff" set:html={diyIndex.letter.signoff} />
      <img
        class="letter__image"
        src="/images/mo_bike.jpg"
        width="1512"
        height="1134"
        alt="A crowd gathered around a man on a Citi Bike as another man steadies him"
      />
      <p class="letter__photo-caption">
        Josh helps <a href="https://nycofftech.com/" target="_blank" rel="noopener">Nick</a> learn how to ride a bike at the first MO NYC exhibition, Feb 2026
      </p>
    </section>

    <!-- 4. The basics -->
    <SectionHeader label={diyIndex.basicsSectionLabel} color="yellow" />
    <section class="card">
      <p class="body" set:html={diyIndex.basics.intro1} />
      <p class="body" set:html={diyIndex.basics.intro2} />
      <div class="program">
        {program.map((step) => (
          <ProgramStep number={step.number} color={step.color} title={step.title} question={step.question} />
        ))}
      </div>
    </section>

    <!-- 5. Ring ring — interest form -->
    <SectionHeader label={diyIndex.ringRingSectionLabel} color="yellow" />
    <section class="lydia">
      <div class="lydia__top">
        <p class="body" set:html={diyIndex.ringRing.paragraph} />
        <img class="lydia__photo" src="/images/lydia.jpg" width="1200" height="1200" alt="Lydia, a Month Offline organizer" />
      </div>
      <a class="lydia__btn font-display" href="https://tally.so/r/RGgD2p">{diyIndex.ringRing.buttonLabel}</a>
    </section>

    <!-- 6. Next -->
    <NextLink label={diyIndex.nextLinkLabel} href="/diy/gather-participants" />
  </div>
</BaseLayout>

<style>
  /* Standard body paragraph (Syne Mono). Spacing between stacked paragraphs. */
  .body {
    font-size: var(--size-body);
    line-height: var(--leading-body);
  }
  .body + .body {
    margin-top: var(--space-3);
  }

  /* Letter salutation + sign-off. */
  .letter__salutation {
    font-size: var(--size-body);
    margin-bottom: var(--space-3);
  }
  .letter__signoff {
    margin-top: var(--space-3);
  }

  /* The field-kit photo that closes the letter. */
  .letter__image {
    width: 100%;
    height: auto;
    margin-top: var(--space-3);
  }
  .letter__photo-caption {
    font-size: calc(var(--size-body) - 2px);
    opacity: 0.5;
    margin-top: var(--space-1);
  }
  .letter__photo-caption a {
    color: inherit;
  }

  /* Vertical breathing room around the audio player in the letter. */
  .letter__audio {
    margin: var(--space-3) 0;
  }

  /* The 5-week program list inside the "How it works" card. */
  .program {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  /* Lydia intro-call card (pink, black text). */
  .lydia {
    background: var(--mo-pink);
    color: var(--black);
    padding: var(--space-2);
  }
  .lydia__top {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .lydia__photo {
    flex: none;
    width: 110px;
    height: 110px;
    object-fit: cover;
  }
  .lydia__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-3);
    padding: var(--space-2);
    background: var(--black);
    color: var(--white);
    text-decoration: none;
    font-size: var(--size-body);
    transition: background-color 0.15s ease;
  }
  /* Hover: lighten the box 20% toward white. */
  .lydia__btn:hover {
    background: color-mix(in srgb, var(--black) 80%, white);
  }
</style>
