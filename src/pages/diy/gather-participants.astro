---
/*
  DIY subpage 1 of 4 — How to Invite Participants (/diy/gather-participants).

  Sections, top to bottom (ticker, masthead, footer come from BaseLayout):
    1. Hero       — the M ❀ logo
    2. Heading    — cyan "* HOW TO INVITE PARTICIPANTS" bar
    3. Body       — the how-to copy, with a flyering photo mid-card
    4. Resources  — pink download cards (PDFs hosted on the site)
    5. Next       — link forward to the next subpage in the read-in-order set

  Underlined words in the body use plain <u> for emphasis (same as the home
  page's "offline.community"/"dumb.co") — they're not links.
---------------------------------------------------------------------------*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import NextLink from '../../components/NextLink.astro';
import { getEntry } from 'astro:content';

const { data: page } = await getEntry('diy-gather-participants', 'page');
---

<BaseLayout title={page.title} masthead={page.masthead}>
  <div class="sections">
    <!-- 1. Hero -->
    <Hero />

    <!-- 2. Heading -->
    <SectionHeader label={page.sectionLabel} color="cyan" />

    <!-- 3. Body -->
    <section class="card">
      <h3 class="label">{page.subheading1}</h3>
      <p class="body" set:html={page.paragraph1} />
      <p class="body" set:html={page.paragraph2} />
      <p class="body" set:html={page.paragraph3} />

      <img
        class="card__photo"
        src="/images/mo_flyer.png"
        width="1500"
        height="1000"
        alt="A hand wheat-pasting a Month Offline poster onto a city wall"
      />

      <p class="body" set:html={page.paragraph4} />
      <p class="body" set:html={page.paragraph5} />

      <h3 class="label">{page.subheading2}</h3>
      <p class="body" set:html={page.paragraph6} />
      <p class="body" set:html={page.paragraph7} />
      <p class="body" set:html={page.paragraph8} />

      <img
        class="card__photo"
        src="/images/participants_02.png"
        width="1512"
        height="1134"
        alt="Month Offline participants gathered around a table at their meetup venue"
      />

      <p class="body" set:html={page.paragraph9} />
    </section>

    <!-- 4. Resources -->
    <SectionHeader label={page.resourcesSectionLabel} />
    {page.resources.map((r) => (
      <ResourceCard title={r.title} description={r.description} href={r.href} />
    ))}

    <!-- 5. Next — read-in-order, per CLAUDE.md (Gather → Get Dumbphones → …). -->
    <NextLink label={page.nextLinkLabel} href="/diy/get-dumbphones" />
  </div>
</BaseLayout>

<style>
  /* Standard body paragraph (Syne Mono). Spacing between stacked paragraphs. */
  .body {
    font-size: var(--size-body);
    line-height: var(--leading-body);
  }
  .body + .body {
    margin-top: var(--space-3);
  }

  /* The flyering photo sits between paragraphs inside the white card. */
  .card__photo {
    width: 100%;
    height: auto;
    margin: var(--space-3) 0;
  }
</style>
