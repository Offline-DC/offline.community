---
/*
  Home page.

  Sections, top to bottom (the ticker, masthead, and footer live in
  BaseLayout and wrap every page):
    1. Hero        — the M ❀ logo in a bordered yellow block
    2. Intro       — what Month Offline is
    3. Press       — "Read all about it" coverage
    4. How it works— meetups, the dumbphone, and the directory blurb
    5. Locations   — the cohort directory (rows with Status "Upcoming")
    6. CTA         — start a cohort in your city → DIY guide, then the
                     "get notified" CTA
    7. Photos      — a strip of three images
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CohortRow from '../components/CohortRow.astro';
import PressItem from '../components/PressItem.astro';
import { getCohorts } from '../lib/cohorts.js';
import { getEntry } from 'astro:content';

// Pull the cohort directory from the published Google Sheet at build time.
// Empty until cohorts are added to the sheet — the section shows an
// empty-state message below in that case.
const cohorts = await getCohorts();

// Only rows that aren't marked "Past" in the sheet's Status column are
// listed under "Month Offline locations". Past cohorts are hidden (there's
// no Past cohorts section anymore).
const upcomingCohorts = cohorts.filter((c) => c.status !== 'past');

// Pull this page's text from src/content/home/home.md, validated against
// the schema in src/content.config.ts. `home.data` is the file's
// frontmatter, e.g. home.data.intro.tagline.
const { data: home } = await getEntry('home', 'home');

// The bullet icon (✺ meetups, ☎ device, ❉ exhibition) is design, not copy —
// it's tied to which "how it works" group this is, not something anyone
// would edit in Craft, so it stays here rather than in the doc. Matched to
// home.howItWorks.groups by position (1st group, 2nd group, 3rd group).
const GROUP_GLYPHS = ['✺', '☎', '❉'];
---

<BaseLayout title={home.title} masthead={home.masthead}>
  <div class="sections">
    <!-- 1. Hero -->
    <Hero />

    <!-- 2. Intro -->
    <section class="card">
      <p class="lead__tagline font-display">{home.intro.tagline}</p>
      <p class="lead__headline font-display">{home.intro.headline}</p>
      <p class="lead__coda font-display">{home.intro.coda}</p>
      <!-- set:html renders the string as real HTML instead of escaping it as
           text — this field's value in home.md has real <u>/<a> tags typed
           directly into the frontmatter. Safe here because that file is
           something you write yourself in the repo, not from a visitor or
           any other untrusted source. -->
      <p class="body" set:html={home.intro.paragraph} />
    </section>

    <!-- 3. Press -->
    <SectionHeader label={home.press.sectionLabel} color="cyan" />
    <section class="card card--gray">
      <ul class="press-list">
        {home.press.items.map((item) => (
          <PressItem headline={item.headline} outlet={item.outlet} href={item.href} />
        ))}
      </ul>
    </section>

    <!-- 4. How it works -->
    <SectionHeader label={home.howItWorks.sectionLabel} color="cyan" />
    <section class="card">
      <p class="body" set:html={home.howItWorks.intro} />

      {home.howItWorks.groups.map((group, i) => (
        <>
          <h3 class="label">{group.heading}</h3>
          <ul class="bullets">
            {group.bullets.map((bullet) => (
              <li>{GROUP_GLYPHS[i]} <span set:html={bullet} /></li>
            ))}
          </ul>
        </>
      ))}
    </section>

    <!-- 5. Locations -->
    <SectionHeader label={home.locations.sectionLabel} color="cyan" />
    <!-- Directory blurb sits beneath the locations header in its own blue box. -->
    <section class="directory-note">
      <p set:html={home.locations.blurb} />
    </section>
    {upcomingCohorts.length > 0
      ? upcomingCohorts.map((c) => (
          <CohortRow location={c.location} date={c.date} description={c.description} href={c.href} />
        ))
      : <p class="no-cohorts">{home.locations.emptyState}</p>
    }

    <!-- 6. CTA → DIY guide -->
    <a class="cta" href="/diy">
      <div class="cta__head">
        <span class="font-display"><span class="cta__icon cta__icon--star">★</span> {home.ctaDiy.heading}</span>
        <span class="font-display">&gt;&gt;&gt;</span>
      </div>
      <p class="cta__blurb">
        {home.ctaDiy.blurb}
      </p>
    </a>

    <!-- Blue CTA → get notified when a cohort launches nearby -->
    <a class="cta cta--notify" href="https://tally.so/r/japgd9" target="_blank" rel="noopener">
      <div class="cta__head">
        <span class="font-display"><span class="cta__icon cta__icon--mail">✉</span> {home.ctaNotify.heading}</span>
        <span class="font-display">&gt;&gt;&gt;</span>
      </div>
      <p class="cta__blurb">
        {home.ctaNotify.blurb}
      </p>
    </a>

    <!-- 7. Photos -->
    <section class="photos">
      <img src="/images/photo-1.png" alt="Participants at a Month Offline meetup" />
      <img src="/images/photo-2.png" alt="A Month Offline gathering" />
      <img src="/images/photo-3.png" alt="A Month Offline exhibition" />
    </section>
  </div>
</BaseLayout>

<style>
  /* `.sections` (the section stack) and `.card` now live in global.css,
     shared across pages. */

  /* Locations empty-state (shown on the black page, white text). */
  .no-cohorts {
    font-size: var(--size-body);
    padding: var(--space-3) var(--space-2);
  }

  .lead__tagline {
    font-size: 15px;
    line-height: var(--leading-display);
    text-align: center;
    white-space: nowrap;
  }
  /* On narrow screens the tagline doesn't fit on one line — let it wrap. */
  @media (max-width: 600px) {
    .lead__tagline {
      white-space: normal;
    }
  }
  .lead__headline {
    font-size: 20px;
    line-height: var(--leading-display);
    text-align: center;
    margin-top: var(--space-2);
  }
  .lead__coda {
    font-size: 20px;
    line-height: var(--leading-display);
    text-align: center;
    margin-top: var(--space-2);
  }

  /* Standard body paragraph (Syne Mono). Home-page copy reads a touch larger
     than the 16px site default. */
  .body {
    font-size: 18px;
    line-height: var(--leading-body);
  }
  .body + .body,
  .bullets + .body {
    margin-top: var(--space-3);
  }
  .lead__coda + .body {
    margin-top: var(--space-3);
  }

  /* Directory blurb box beneath the "Month Offline locations" header. */
  .directory-note {
    background: var(--mo-cyan);
    color: var(--black);
    padding: var(--space-3);
    font-size: var(--size-body);
    line-height: var(--leading-body);
  }

  .bullets {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }
  .bullets li + li {
    margin-top: var(--space-2);
  }
  /* The dumb.co link (under "dumb device") reads as a body-copy link: blue,
     underlined, inverting to a solid blue block on hover. */
  .bullets a {
    color: var(--mo-blue);
    text-decoration: underline;
  }
  .bullets a:hover {
    background-color: var(--mo-blue);
    color: var(--white);
  }

  /* Press list: headlines separated by thin black rules. */
  .press-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .press-list :global(.press-item) {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--black);
  }
  .press-list :global(.press-item:first-child) {
    padding-top: 0;
  }
  .press-list :global(.press-item:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  /* CTA bar (pink). */
  .cta {
    display: block;
    background: var(--mo-pink);
    color: var(--black);
    text-decoration: none;
    padding: var(--space-2);
    min-height: var(--bar-cta);
    transition: background-color 0.15s ease;
  }
  /* Hover: lighten the box 20% toward white. */
  .cta:hover {
    background: color-mix(in srgb, var(--mo-pink) 80%, white);
  }
  /* Blue variant ("get notified") — white text for contrast on blue. */
  .cta--notify {
    background: var(--mo-blue);
    color: var(--white);
  }
  .cta--notify:hover {
    background: color-mix(in srgb, var(--mo-blue) 80%, white);
  }
  .cta__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    font-size: var(--size-body);
  }
  .cta__head .font-display:last-child {
    transition: transform 0.15s ease;
  }
  .cta:hover .cta__head .font-display:last-child {
    transform: translateX(4px);
  }

  /* The star/envelope glyphs render much smaller than Workbench's capital
     letters at the same font-size (Workbench doesn't include these symbols,
     so the browser substitutes a fallback font whose glyphs sit small and
     high in the em box). Scale each one up so its ink height roughly
     matches the surrounding caps, then nudge back onto the baseline. */
  .cta__icon {
    line-height: 1;
  }
  .cta__icon--star {
    font-size: 1.64em;
  }
  .cta__icon--mail {
    font-size: 2.16em;
    vertical-align: -2px;
  }
  .cta__blurb {
    font-size: var(--size-body);
    margin-top: var(--space-1);
  }

  /* Photo strip: three equal-width images in a row. */
  .photos {
    display: flex;
    align-items: flex-start; /* don't stretch shorter photos to match the tallest */
    gap: var(--space-1);
    margin-top: 32px;
  }
  .photos img {
    flex: 1;
    width: 0; /* let flex-basis drive width so all three are equal */
    height: auto; /* keep each photo's natural aspect ratio, no cropping */
  }
</style>
