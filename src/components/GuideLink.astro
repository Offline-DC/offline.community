---
/*
  GuideLink.astro — a link row on the DIY guide landing page, e.g.
  "01. INVITE PARTICIPANTS  >>>". Links to a subpage or the Resource Library.

  Looks: a black box with a colored outline and white text. On hover it fills
  in with that color (the rows' old solid look). `color` picks the outline /
  fill: yellow (default), cyan, pink, or blue. Blue gets white text when
  filled to stay legible (matches the blue sub-heading bars elsewhere on the
  site); the others switch to black.
*/
interface Props {
  number: string; // e.g. "01"
  label: string;  // e.g. "Invite participants"
  href: string;   // e.g. "/diy/gather-participants"
  color?: 'yellow' | 'cyan' | 'pink' | 'blue';
}
const { number, label, href, color = 'yellow' } = Astro.props;
const textColor = color === 'blue' ? 'var(--white)' : 'var(--black)';
---

<a class="guide-link" href={href} style={`--guide-link-color: var(--mo-${color}); --guide-link-text: ${textColor};`}>
  <span class="guide-link__label font-display">{number}. {label}</span>
  <span class="guide-link__arrow font-display">&gt;&gt;&gt;</span>
</a>

<style>
  .guide-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    background: var(--black);
    color: var(--white);
    /* Outline drawn inside the box (inset shadow) so it doesn't add size. */
    box-shadow: inset 0 0 0 1px var(--guide-link-color);
    text-decoration: none;
    padding: var(--space-2);
    min-height: var(--bar-section);
    font-size: var(--size-body);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  /* Hover: fill in with the outline color. */
  .guide-link:hover {
    background: var(--guide-link-color);
    color: var(--guide-link-text);
  }
  .guide-link__arrow {
    transition: transform 0.15s ease;
  }
  .guide-link:hover .guide-link__arrow {
    transform: translateX(4px);
  }
</style>
